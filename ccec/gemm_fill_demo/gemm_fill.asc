/* !
 * \file gemm_fill.asc
 * \brief 带 L1 补零（asc_fill_l1）的 CUBE GEMM：C[M,N] = A[M,K] x B[K,N]，half 输入 /
 * float 累加输出。
 *
 * 与 gemm_demo 的区别：K=208 不是 L1 分块 K_TILE=256 的整数倍（K 只有 13 个 16 列分形，
 * L1 按 16 个分形分配），最后 3 个 k 分形是"补边区"。为了让 k 循环拍数固定、并且让
 * mmad 能覆盖整块 L1，这 3 个分形必须显式清零，否则会把上一拍/越界数据累加进 C。
 * 补零用 `asc_fill_l1(...)`（硬件 create_cbuf_matrix 指令）完成。
 *
 * ---------------------------------------------------------------------------
 * CANN 9.2.1 迁移（本文件已按 9.2.1 改写，需要 CANN >= 9.2.1）
 * ---------------------------------------------------------------------------
 *   `asc_fill_l1_sync` 自 9.2.0 起被标记为
 *     ASC_DEPRECATED(9.2.0, "2027/09/07", "asc_fill_l1 and asc_sync")
 *   它内部等价于 `create_cbuf_matrix(...)` + `pipe_barrier(PIPE_ALL)`，即每条补零
 *   （A、B 各一条）都强制一次全流水线屏障。9.2.1 的写法是：
 *     - 补零只用异步的 `asc_fill_l1(...)`；
 *     - 与 GM->L1 搬运一起，在每个变体末尾用一次 `asc_sync()` 收口；
 *     - 热循环（L1->L0 -> mmad -> L0C->GM）不再用 PIPE_ALL 屏障，而是用 9.2.1 新增
 *       支持的 cube 侧事件对：MTE1<->M、M<->FIX（见 asc_sync_notify/asc_sync_wait）。
 *   于是每拍 2 次 PIPE_ALL 屏障变成 2 次细粒度 set_flag/wait_flag。
 *
 * 本样例同时给出 4 个变体，用于验证"补零到底补在哪、补多少"：
 *   v0 窄搬入(K=208) + 补零 3 个分形   -> 正确
 *   v1 全宽搬入(K_TILE=256) + 不补零    -> 错误（尾部毒化数据被累加）
 *   v2 全宽搬入(K_TILE=256) + 补零 3 个分形 -> 正确
 *   v3 全宽搬入(K_TILE=256) + 补零 2 个分形 -> 错误（少补 1 个分形）
 * host 侧与 CPU 三重循环逐元素比对，v0/v2 期望 max error = 0，v1/v3 期望明显非 0。
 *
 * ---------------------------------------------------------------------------
 * asc_fill_l1 语义（来源于 CANN 实现，见 README 的"补零语义核对"一节）
 * ---------------------------------------------------------------------------
 *   void asc_fill_l1(__cbuf__ T* dst, T value, asc_fill_value_config cfg);
 *   cfg 是 64bit 打包参数：
 *     [14:0]  repeat   —— 重复次数
 *     [30:16] blk_num  —— 每次重复写多少个 32B block（连续）
 *     [46:32] dst_gap  —— 两次重复之间跳过的 32B block 数
 *   语义：for r in [0, repeat):
 *           fill  dst + r * (blk_num + dst_gap) * 32B  开始的 blk_num 个 32B block = value
 *   即：地址步进以 32B 为单位，value 按元素类型广播（half 时每个 32B block 16 个元素）。
 *
 * ---------------------------------------------------------------------------
 * L1 里的 NZ 布局（由 nd2nz 的 MTE2_NZ_PARA 决定，本样例用 asc_set_gm2l1_nz_para 设置）
 * ---------------------------------------------------------------------------
 *   NZ 分形 [m1][k1][16][16]（k1 在最内层）：
 *     elem(m, k) 偏移 = (m/16)*K1*256 + (k/16)*256 + (m%16)*16 + (k%16)
 *   => 第 mf 个 m 分形、第 kf 个 k 分形的起始元素偏移 = (mf*K1 + kf) * 256
 *   => 一个 16x16 half 分形 = 512B = 16 个 32B block
 *
 *   于是"k >= 13 的补边区"在每个 m 分形内是连续的 3 个分形 = 48 个 32B block，
 *   相邻 m 分形之间要跳过 13 个有效分形 = 208 个 32B block。这就是补零参数的来源：
 *     repeat = M/16 = 4, blk_num = (16-13)*16 = 48, dst_gap = 13*16 = 208
 *   参数核对：重复步进 (48+208)*32B = 8192B = 4096 half = 一个 m 分形的跨度
 *   (K_TILE/16)*256 = 16*256 = 4096 ✓
 *
 * 构建/运行（npu 模式，dav-3510）：
 *   cmake -B build -DCMAKE_ASC_RUN_MODE=npu -DCMAKE_ASC_ARCHITECTURES=dav-3510
 *   cmake --build build
 *   ./build/demo [device_id]
 */

#include <cmath>
#include <cstdint>
#include <iostream>
#include <vector>

#include "acl/acl.h"
#include "c_api/asc_simd.h"

// ---------------------------------------------------------------------------
// 问题尺寸：M/N 16 对齐（只考察 K 方向补零），K=208 不是 K_TILE=256 的整数倍
// ---------------------------------------------------------------------------
constexpr uint32_t M = 64;
constexpr uint32_t N = 128;
constexpr uint32_t K_VALID = 208; // 真实 K = 13 个 16 列分形
constexpr uint32_t K_TILE = 256;  // L1 内 K 方向按 16 个分形分配（尾部 3 个分形是补边区）

constexpr uint32_t FRACTAL = 16;                       // CUBE 单元 16x16x16
constexpr uint32_t FRACTAL_ELEMS = FRACTAL * FRACTAL;  // 256 half = 512B
constexpr uint32_t BLOCK_BYTES = 32;                   // 补零指令的地址步进单位

constexpr uint32_t K1_VALID = K_VALID / FRACTAL; // 13
constexpr uint32_t K1_TILE = K_TILE / FRACTAL;   // 16
constexpr uint32_t M1 = M / FRACTAL;             // 4
constexpr uint32_t N1 = N / FRACTAL;             // 8

constexpr uint32_t VARIANTS = 4;
constexpr uint32_t CYCLES_PER_VARIANT = 4; // copy / fill / mmad / total

// 变体参数：各变体向 L1 搬运的 K 宽度、以及补零覆盖几个 k 分形
constexpr uint32_t COPY_K[VARIANTS] = {K_VALID, K_TILE, K_TILE, K_TILE};
constexpr uint32_t FILL_FRACTALS[VARIANTS] = {3, 0, 3, 2};

// 毒化数据：GM 里 k >= K_VALID 的区域填 100.0，一旦漏进 L1 就会让 C 明显偏大
constexpr float POISON = 100.0f;

// 阻止编译器对 get_sys_cnt() 做 CSE / 常量折叠
__attribute__((noinline)) __aicore__ int64_t get_sys_cnt_safe()
{
    return get_sys_cnt();
}

/* !
 * \brief 设置 nd2nz 的目标 NZ 布局（MTE2_NZ_PARA）。
 * MTE2_NZ_PARA[15:0]=nd_num, [31:16]=dst_nz_n_stride, [47:32]=dst_nz_c0_stride,
 * [63:48]=dst_nz_matrix_stride。n_stride=1 / c0_stride=16 对应 [m1][k1][16][16]。
 */
__aicore__ inline void set_l1_nz_layout(uint16_t nd_num, uint16_t n_stride, uint16_t c0_stride, uint16_t matrix_stride)
{
    uint64_t para = (static_cast<uint64_t>(matrix_stride) << 48) | (static_cast<uint64_t>(c0_stride) << 32) |
                    (static_cast<uint64_t>(n_stride) << 16) | static_cast<uint64_t>(nd_num);
    asc_set_gm2l1_nz_para(para);
}

/* !
 * \brief 用 asc_fill_l1 把 L1 上一段"带间隔的连续 32B block 区域"填成 0。
 * \param dst      起始地址（half 指针，硬件按 32B block 对齐寻址）
 * \param repeat   重复次数
 * \param blk_num  每次重复填充的 32B block 数
 * \param dst_gap  两次重复之间跳过的 32B block 数
 *
 * 9.2.1：只用异步版本，不再在函数内加屏障；调用方在搬入/补零都发射完后
 * 用一次 `asc_sync()` 收口（替代已弃用的 asc_fill_l1_sync）。
 */
__aicore__ inline void fill_l1_zero(__cbuf__ half *dst, uint16_t repeat, uint16_t blk_num, uint16_t dst_gap)
{
    asc_fill_value_config cfg;
    cfg.repeat = repeat;
    cfg.blk_num = blk_num;
    cfg.dst_gap = dst_gap;
    asc_fill_l1(dst, static_cast<half>(0.0f), cfg);
}

/* !
 * \brief 补零 A/B 的 k 尾部（每个 m/n 分形里从 K1_VALID 分形到 K1_TILE 分形的区域）。
 * \param l1       L1 基址
 * \param outer    外层分形个数（A: M/16，B: N/16）
 * \param fill_k1  需要补零的 k 分形个数
 */
__aicore__ inline void pad_zero_k_tail(__cbuf__ half *l1, uint32_t outer, uint32_t fill_k1)
{
    // 起点：第 0 个外分形、第 K1_VALID 个 k 分形
    __cbuf__ half *dst = l1 + K1_VALID * FRACTAL_ELEMS;
    // 每个 k 分形 = 16 个 32B block
    uint16_t blk_num = static_cast<uint16_t>(fill_k1 * FRACTAL);
    // 跳过 K1_VALID 个有效 k 分形
    uint16_t dst_gap = static_cast<uint16_t>(K1_VALID * FRACTAL);
    fill_l1_zero(dst, static_cast<uint16_t>(outer), blk_num, dst_gap);
}

/* !
 * A 在 GM 中为 [M, K_TILE] 行主序（k 连续）；B 在 GM 中为 [N, K_TILE] 行主序（k 连续，即转置）；
 * C 输出 [M, N] 行主序。每个变体输出到 c_gm 的一段独立区域。
 */
__global__ __aicore__ void gemm_fill_kernel(__gm__ half *a_gm, __gm__ half *b_gm, __gm__ float *c_gm,
                                            __gm__ int64_t *cycles_gm)
{
    asc_init();

    // L1（NZ 分形布局，K 方向按 K_TILE 分配）与 L0 缓冲
    __cbuf__ half a_l1[M * K_TILE];
    __cbuf__ half b_l1[N * K_TILE];
    __ca__ half a_l0[FRACTAL_ELEMS];
    __cb__ half b_l0[FRACTAL_ELEMS];
    __cc__ float c_l0[FRACTAL_ELEMS];

    // nd2nz 目标布局：[m1][k1][16][16]
    set_l1_nz_layout(1, 1, 16, 0);

    for (uint32_t v = 0; v < VARIANTS; ++v) {
        const uint32_t copy_k = COPY_K[v];
        const uint32_t fill_k1 = FILL_FRACTALS[v];

        int64_t t_begin = get_sys_cnt_safe();

        // ------------------------------------------------------------------
        // 1) GM -> L1：copy_k 列做 ND->NZ 分形转换（MTE2）
        // ------------------------------------------------------------------
        int64_t s = get_sys_cnt_safe();
        // 9.2.1 的推荐重载：第 3 个参数是源行步长（字节），L2 cache 模式改成强类型枚举
        asc_copy_gm2l1_nd2nz(a_l1, a_gm, K_TILE * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, M,
                             copy_k, 0, false);
        asc_copy_gm2l1_nd2nz(b_l1, b_gm, K_TILE * sizeof(half), asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, N,
                             copy_k, 0, false);
        int64_t t_copy = get_sys_cnt_safe() - s;

        // ------------------------------------------------------------------
        // 2) 补零 k 尾部（asc_fill_l1 -> create_cbuf_matrix）
        // ------------------------------------------------------------------
        s = get_sys_cnt_safe();
        if (fill_k1 > 0) {
            pad_zero_k_tail(a_l1, M1, fill_k1);
            pad_zero_k_tail(b_l1, N1, fill_k1);
        }
        // 9.2.1 的替代写法：补零是异步指令，和上面的 nd2nz 一起在这里收口一次。
        // （等价于被弃用的 asc_fill_l1_sync 里那句 pipe_barrier(PIPE_ALL)，
        //   但每条补零不再各自带一个屏障；v1 没有补零时，这一句同时保证 nd2nz 写完 L1。）
        asc_sync();
        int64_t t_fill = get_sys_cnt_safe() - s;

        // ------------------------------------------------------------------
        // 3) L1 -> L0 + mmad（PIPE_MTE1 / PIPE_M）
        //    k 循环固定跑满 K1_TILE 个分形：补边区靠第 2 步的清零贡献 0
        // ------------------------------------------------------------------
        s = get_sys_cnt_safe();
        for (uint32_t nf = 0; nf < N1; ++nf) {
            for (uint32_t mf = 0; mf < M1; ++mf) {
                for (uint32_t kf = 0; kf < K1_TILE; ++kf) {
                    __cbuf__ half *a_frac = a_l1 + (mf * K1_TILE + kf) * FRACTAL_ELEMS;
                    __cbuf__ half *b_frac = b_l1 + (nf * K1_TILE + kf) * FRACTAL_ELEMS;

                    // 单个 16x16 分形：m_start/k_start/m_step/k_step 全为 0/1，指针已定位到分形起点
                    asc_copy_l12l0a(a_l0, a_frac, 0, 0, 1, 1, 1, 1);
                    // B 在 L1 里同样是 [n,k] 分形，进 L0B 需要转置(Zn)。
                    // 9.2.1 头文件里有两个同参数的 l12l0b_trans 重载：
                    //   (…, dst_gap, bool enable_addr_decrement, uint16_t dst_frac_gap)   <- 只有声明
                    //   (…, dst_gap, uint16_t dst_frac_gap,      uint16_t src_frac_gap)   <- 有实现
                    // 前者在 9.2.1 里没有 .cube 实现（链接会报 undefined symbol），所以这里显式用
                    // uint16_t 的 0 选中后者（两个 frac gap 都取 0，等价于单分形搬运）。
                    asc_copy_l12l0b_trans(b_l0, b_frac, 0, 1, 1, 0, static_cast<uint16_t>(0),
                                          static_cast<uint16_t>(0));
                    // L0A/L0B 就绪（MTE1 -> M）。9.2.1 起 cube 侧支持这组事件对，
                    // 不用再每拍一次 pipe_barrier(PIPE_ALL)
                    asc_sync_notify(PIPE_MTE1, PIPE_M, EVENT_ID0);
                    asc_sync_wait(PIPE_MTE1, PIPE_M, EVENT_ID0);

                    // m/k/n = 16/16/16；disable_gemv=false；c_matrix_source=(累计)；
                    // c_matrix_init_val=(首拍清零)
                    asc_mmad(c_l0, a_l0, b_l0, FRACTAL, FRACTAL, FRACTAL, asc_unit_flag_mode::DISABLE, false,
                             (kf > 0), (kf == 0));
                    // mmad 读完 L0A/L0B 后，下一拍才能覆盖（M -> MTE1）
                    asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
                    asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
                }
                // mmad 结果对 FIX 可见（M -> FIX）
                asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
                asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);

                // ----------------------------------------------------------
                // 4) L0C -> GM（PIPE_FIX，nz2nd 还原常规 ND 布局）
                // ----------------------------------------------------------
                __gm__ float *c_tile = c_gm + v * M * N + (mf * FRACTAL) * N + nf * FRACTAL;
                // 9.2.1 的推荐重载（14 参数版）：量化/relu 用强类型枚举，其余开关显式给全
                asc_copy_l0c2gm(c_tile, c_l0, FRACTAL, FRACTAL, N, 1,
                                asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM, asc_unit_flag_mode::DISABLE,
                                asc_quant_mode::NoQuant, asc_relu_pre_mode::NONE, false /*channel_split*/,
                                true /*nz2nd*/, false /*nz2dn*/, false /*clip_relu_pre*/);
                // 写完再让下一拍 mmad 覆盖 L0C（FIX -> M）
                asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
                asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
            }
        }
        int64_t t_mmad = get_sys_cnt_safe() - s;

        cycles_gm[v * CYCLES_PER_VARIANT + 0] = t_copy;
        cycles_gm[v * CYCLES_PER_VARIANT + 1] = t_fill;
        cycles_gm[v * CYCLES_PER_VARIANT + 2] = t_mmad;
        cycles_gm[v * CYCLES_PER_VARIANT + 3] = get_sys_cnt_safe() - t_begin;
    }

    asc_sync();
}

// ---------------------------------------------------------------------------
// Host 侧：与设备无关的"补零几何"自检
// ---------------------------------------------------------------------------
/* !
 * \brief 用主机侧模型复现 asc_fill_l1 的地址游走，检查它覆盖的 32B block 是否
 *        正好等于"所有 k >= K_VALID 的 32B block"，并把结果打印出来。
 *
 * 这一步不需要 NPU，用于在没有设备的环境下核对参数推导（repeat/blk_num/dst_gap
 * 与 NZ 布局的对应关系）；真正"补零是否让 C 变对"由 4 个变体在设备上验证。
 */
void self_check_fill_geometry()
{
    const uint32_t total_blocks = M * K_TILE * sizeof(half) / BLOCK_BYTES; // A 的 32B block 总数
    const uint32_t repeat = M1;
    const uint32_t blk_num = (K1_TILE - K1_VALID) * FRACTAL;    // 每个 k 分形 16 个 32B block
    const uint32_t dst_gap = K1_VALID * FRACTAL;
    const uint32_t base_block = K1_VALID * FRACTAL_ELEMS * sizeof(half) / BLOCK_BYTES;

    std::vector<uint8_t> covered(total_blocks, 0);
    for (uint32_t r = 0; r < repeat; ++r) {
        for (uint32_t b = 0; b < blk_num; ++b) {
            uint32_t blk = base_block + r * (blk_num + dst_gap) + b;
            if (blk < total_blocks) {
                covered[blk] = 1;
            }
        }
    }

    // 期望：NZ 布局 [m1][k1][16][16] 下，凡是 kf >= K1_VALID 的 block 都应被覆盖
    uint32_t mismatch = 0;
    for (uint32_t blk = 0; blk < total_blocks; ++blk) {
        uint32_t kf = (blk / FRACTAL) % K1_TILE;
        bool expect = (kf >= K1_VALID);
        if (expect != (covered[blk] != 0)) {
            ++mismatch;
        }
    }

    uint32_t covered_cnt = 0;
    for (uint32_t blk = 0; blk < total_blocks; ++blk) {
        covered_cnt += covered[blk];
    }

    std::cout << "[fill-geometry self-check] A tile: " << total_blocks << " 个 32B block, 补零覆盖 "
              << covered_cnt << " 个"
              << " (期望 " << M1 * (K1_TILE - K1_VALID) * FRACTAL << " = M/16 * 3分形 * 16block), mismatch = "
              << mismatch << " -> " << (mismatch == 0 ? "OK" : "BAD") << std::endl;

    // 第 0 个 m 分形里每个 k 分形是否被覆盖（. = 有效区, # = 补零区）
    std::cout << "[fill-geometry self-check] m-fractal 0 覆盖图: ";
    for (uint32_t kf = 0; kf < K1_TILE; ++kf) {
        uint32_t blk = kf * FRACTAL; // m0 = 0
        std::cout << (covered[blk] ? "#" : ".");
    }
    std::cout << "   (. 有效 k 分形 13 个 / # 补零 k 分形 3 个)" << std::endl;
}

// ---------------------------------------------------------------------------
// Host 侧
// ---------------------------------------------------------------------------
int32_t main(int32_t argc, char *argv[])
{
    int32_t device_id = 0;
    if (argc > 1) {
        device_id = std::atoi(argv[1]);
    }

    constexpr uint32_t a_elems = M * K_TILE;
    constexpr uint32_t b_elems = N * K_TILE; // B 转置存放
    constexpr uint32_t c_elems = M * N;
    constexpr uint32_t cycles_count = VARIANTS * CYCLES_PER_VARIANT;

    // 输入：小整数（half 精确可表示），fp32 累加全程精确；k >= K_VALID 的尾部毒化为 POISON
    std::vector<half> a(a_elems);
    std::vector<half> b(b_elems);
    for (uint32_t i = 0; i < M; ++i) {
        for (uint32_t k = 0; k < K_TILE; ++k) {
            a[i * K_TILE + k] = (k < K_VALID)
                                    ? static_cast<half>(static_cast<float>((i * 3 + k * 5) % 13 - 6))
                                    : static_cast<half>(POISON);
        }
    }
    for (uint32_t j = 0; j < N; ++j) {
        for (uint32_t k = 0; k < K_TILE; ++k) {
            b[j * K_TILE + k] = (k < K_VALID)
                                    ? static_cast<half>(static_cast<float>((j * 7 + k * 11) % 17 - 8))
                                    : static_cast<half>(POISON);
        }
    }

    size_t a_bytes = a_elems * sizeof(half);
    size_t b_bytes = b_elems * sizeof(half);
    size_t c_bytes = VARIANTS * c_elems * sizeof(float);

    half *a_device = nullptr;
    half *b_device = nullptr;
    float *c_device = nullptr;
    int64_t *cycles_device = nullptr;
    float *c_host = nullptr;
    int64_t *cycles_host = nullptr;

    // 无 NPU 设备的环境（例如纯开发机上）直接给出明确提示并退出，避免后续访问非法设备内存
    // 先做与设备无关的补零几何自检（无 NPU 也能看到结果）
    self_check_fill_geometry();

    aclError ret = aclInit(nullptr);
    if (ret != ACL_ERROR_NONE) {
        std::cerr << "[ERROR] aclInit failed, ret = " << (int)ret << std::endl;
        return 1;
    }
    ret = aclrtSetDevice(device_id);
    if (ret != ACL_ERROR_NONE) {
        std::cerr << "[ERROR] aclrtSetDevice(" << device_id << ") failed, ret = " << (int)ret << std::endl;
        std::cerr << "        (本 demo 需要机器上存在 Ascend NPU，devId 需有效；无设备环境只能验证编译)"
                  << std::endl;
        aclFinalize();
        return 1;
    }

    aclrtMallocHost((void **)(&c_host), c_bytes);
    aclrtMallocHost((void **)(&cycles_host), cycles_count * sizeof(int64_t));
    aclrtMalloc((void **)&a_device, a_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&b_device, b_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&c_device, c_bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void **)&cycles_device, cycles_count * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(a_device, a_bytes, a.data(), a_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(b_device, b_bytes, b.data(), b_bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(c_device, c_bytes, 0, c_bytes);

    gemm_fill_kernel<<<1, 0>>>(a_device, b_device, c_device, cycles_device);
    aclError sync_ret = aclrtSynchronizeDevice();
    if (sync_ret != ACL_ERROR_NONE) {
        std::cerr << "[ERROR] kernel 执行失败, aclrtSynchronizeDevice ret = " << (int)sync_ret << std::endl;
        std::cerr << "        (常见原因：无可用 NPU / 设备被占用 / kernel 内越界)" << std::endl;
        aclrtResetDevice(device_id);
        aclFinalize();
        return 1;
    }

    aclrtMemcpy(c_host, c_bytes, c_device, c_bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(cycles_host, cycles_count * sizeof(int64_t), cycles_device, cycles_count * sizeof(int64_t),
                ACL_MEMCPY_DEVICE_TO_HOST);

    // 参考结果：只累加 k < K_VALID 的部分
    std::vector<float> c_ref(c_elems, 0.0f);
    for (uint32_t i = 0; i < M; ++i) {
        for (uint32_t j = 0; j < N; ++j) {
            float ref = 0.0f;
            for (uint32_t k = 0; k < K_VALID; ++k) {
                ref += static_cast<float>(a[i * K_TILE + k]) * static_cast<float>(b[j * K_TILE + k]);
            }
            c_ref[i * N + j] = ref;
        }
    }

    // 逐变体比对
    const char *names[VARIANTS] = {"v0 窄搬入(208) + 补3分形", "v1 全宽搬入(256) + 不补零",
                                   "v2 全宽搬入(256) + 补3分形", "v3 全宽搬入(256) + 只补2分形"};
    const bool expect_pass[VARIANTS] = {true, false, true, false};
    // 漏补的 k 分形数：v1 一个都没补(3)，v3 少补 1 个(1)
    const float missing_fractals[VARIANTS] = {0.0f, 3.0f, 0.0f, 1.0f};

    std::cout << "GEMM [" << M << "x" << K_VALID << "] x [" << K_VALID << "x" << N
              << "]  (half x half -> float), L1 K 方向按 " << K_TILE << " 补齐" << std::endl;
    std::cout << "补零参数: repeat=" << M1 << ", blk_num=(K1_TILE-K1_VALID)*16=" << (K1_TILE - K1_VALID) * 16
              << ", dst_gap=K1_VALID*16=" << K1_VALID * 16 << std::endl;
    std::cout << "尾部毒化值 = " << POISON << "，漏补 t 个 k 分形时误差约 " << POISON * POISON << " * 16 * t"
              << std::endl;

    bool all_ok = true;
    for (uint32_t v = 0; v < VARIANTS; ++v) {
        const float *c_v = c_host + v * c_elems;
        float max_error = 0.0f;
        uint32_t err_cnt = 0;
        for (uint32_t idx = 0; idx < c_elems; ++idx) {
            float diff = std::fabs(c_v[idx] - c_ref[idx]);
            if (diff > max_error) {
                max_error = diff;
            }
            if (diff > 0.0f) {
                ++err_cnt;
            }
        }
        bool pass = (max_error == 0.0f);
        bool ok = (pass == expect_pass[v]);
        all_ok = all_ok && ok;

        std::cout << "\n"
                  << names[v] << std::endl;
        std::cout << "  max abs error = " << max_error << "  (漏补 " << missing_fractals[v]
                  << " 个 k 分形时误差常量 " << POISON * POISON * 16.0f * missing_fractals[v]
                  << ")" << std::endl;
        std::cout << "  wrong elements = " << err_cnt << " / " << c_elems << std::endl;
        std::cout << "  result: " << (pass ? "PASS(=参考值)" : "MISMATCH(与参考值不一致)")
                  << "  [预期: " << (expect_pass[v] ? "PASS" : "MISMATCH") << " -> " << (ok ? "OK" : "UNEXPECTED")
                  << "]" << std::endl;
    }

    std::cout << "\nKernel cycle stats (get_sys_cnt, AI Core cycles):" << std::endl;
    for (uint32_t v = 0; v < VARIANTS; ++v) {
        const int64_t *cy = cycles_host + v * CYCLES_PER_VARIANT;
        std::cout << "  v" << v << ": GM->L1 " << cy[0] << " | 补零 " << cy[1] << " | L1->L0+mmad " << cy[2]
                  << " | total " << cy[3] << std::endl;
    }

    std::cout << "\noverall: " << (all_ok ? "ALL AS EXPECTED" : "UNEXPECTED RESULT") << std::endl;

    aclrtFree(a_device);
    aclrtFree(b_device);
    aclrtFree(c_device);
    aclrtFree(cycles_device);
    aclrtFreeHost(c_host);
    aclrtFreeHost(cycles_host);

    aclrtResetDevice(device_id);
    aclFinalize();
    return all_ok ? 0 : 1;
}
