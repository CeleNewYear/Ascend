/* !
 * \file pltm_demo.asc
 * \brief Ascend950 (DAV_3510) PLTM 指令验证与演示样例。
 *
 * 目标：与 plt_demo 完全相同的验证口径 —— 全 1 向量、运行时 x、前 x 个元素翻倍为 2、
 *       其余保持 1；区别是本样例用 ccec 内建 `pltm_b32(offset, ub)` 生成运行时 mask。
 *       x 同样是运行时从 GM 读入的动态值。
 *
 * PLTM 与 PLT 的本质区别（V300 VF 硬件）：
 *   - PLT  (plt_b32(count, POST_UPDATE))       ：有状态。一个"剩余计数"标量即输入也即输出，
 *                                                每调用一次自动减一帧(64)。适合 while 尾块循环。
 *   - PLTM (pltm_b32(offset, ub))              ：无状态。两个输入都"只读"：
 *        * offset（u16）= 当前这一帧之前已经处理完的整帧数（帧号）；offset*64 = 已覆盖元素数；
 *        * ub（u32）   = 待处理元素总数的上界。
 *        生成的 mask：lane i = 1  iff  (i + offset*64 < ub)
 *       —— 即"从第 offset*64 个元素开始往后的 ub - offset*64 个元素"落在本帧内的部分。
 *       若剩余量 >= 64 则整帧全 1；若剩余量 <= 0 则整帧全 0。
 *
 * 用法场景：编译器在固定步长循环（每帧 64 元素、帧号就是循环变量）里为每个帧生成一条
 *          PLTM —— 帧号直接作为 offset，无需维护递减计数，天然可展开/可做循环优化。
 *
 * 验证的等价性：对第 f 帧（0 起），pltm_b32(f, x) 等价于循环里第 f 次 plt_b32(remaining, ...)
 *              当 remaining = x - f*64 时生成的 mask；两 demo 输出必须一致。
 */

#include <cstdint>
#include <vector>
#include <iostream>
#include "acl/acl.h"
#include "c_api/asc_simd.h"
#include "data_utils.h"

// 输入总长度（float 元素个数）。256 个 float = 1KB，共 4 帧（每帧 64 lane，b32）。
constexpr std::uint32_t TOTAL_LENGTH = 256;
constexpr std::uint32_t OUT_ALIGN_SIZE = TOTAL_LENGTH;

// ---------------------------------------------------------------------------
// Device 侧
// ---------------------------------------------------------------------------

// 核心 vf 函数：用 PLTM 生成的 mask 做 predicated 翻倍（只处理前 active_count 个元素）
//
// 每帧流程（frame = 0, 1, ..., num_frames-1）：
//   1. vmask = pltm_b32(frame, active_count)
//        - 硬件语义：lane i 为 1  iff (i + frame*64 < active_count)
//        - frame=0（ub=x）          ：前 min(x,64) 个 lane 为 1；
//        - 中间帧（frame*64+64<=x） ：整帧全 1；
//        - 尾帧（x%64 != 0）        ：前 (x - frame*64) 个 lane 为 1；
//        - 越过 x 的帧             ：整帧全 0（空转，vsts 不写任何 lane）。
//   2. vlds 全量读入一帧（64 个 1.0f）
//   3. vmuls(..., 2.0f, vmask, MODE_ZEROING) : active lane 1*2=2；inactive lane 清零
//   4. vsts(..., vmask)（predicated store）  : 只写 active lane；其余 lane 保持 GM 底色 1。
__simd_vf__ inline void pltm_masked_scale_vf(
    __ubuf__ float* x_local, __ubuf__ float* y_local,
    uint32_t active_count, uint32_t total_len, uint16_t one_rep_size)
{
    vector_float src_reg;
    vector_float dst_reg;
    vector_bool vmask;
    // 总帧数 = ceil(total_len / 64)。total_len 编译期 256 → 4 帧；active_count 运行时任意值
    uint32_t num_frames = (total_len + one_rep_size - 1) / one_rep_size;

    for (uint32_t frame = 0; frame < num_frames; ++frame) {
        // PLTM 双参数都是"只读"输入：offset=当前帧号（已处理整帧数），ub=总元素上界
        // 无需像 PLT 那样维护递减计数 —— 帧号由循环变量直接给出。
        vmask = pltm_b32((uint16_t)frame, active_count);
        vlds(src_reg, x_local + frame * one_rep_size, 0, NORM);
        vmuls(dst_reg, src_reg, 2.0f, vmask, MODE_ZEROING);
        vsts(dst_reg, y_local + frame * one_rep_size, 0, NORM_B32, vmask);
    }
}

// kernel 主体（标量上下文）：GM->UB 搬入 -> vf 计算 -> UB->GM 搬出
// active_count 是运行时动态值：host 在启动 kernel 时以标量实参传入（input/x.bin 读出），
// 设备侧直接作为普通标量形参使用 —— 与 CUDA 的标量 kernel 参数语义一致。
__vector__ __global__ void pltm_demo_kernel(
    __gm__ float* x_gm, __gm__ float* y_gm, uint32_t active_count)
{
    asc_init();

    if (active_count > TOTAL_LENGTH) {
        active_count = TOTAL_LENGTH; // 防御性钳制；正常路径 x < TOTAL_LENGTH
    }

    __ubuf__ float x_local[TOTAL_LENGTH];
    __ubuf__ float y_local[TOTAL_LENGTH]; // 输出底色（GM y_gm 已预置全 1）会先搬进来

    // GM -> UB（PIPE_MTE2）：输入全 1 向量 + 输出底色全 1
    asc_copy_gm2ub_align((__ubuf__ float*)x_local, x_gm, 1, TOTAL_LENGTH * sizeof(float), 0, 0, false, 0, 0, 0);
    asc_copy_gm2ub_align((__ubuf__ float*)y_local, y_gm, 1, TOTAL_LENGTH * sizeof(float), 0, 0, false, 0, 0, 0);
    asc_sync_notify(PIPE_MTE2, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE2, PIPE_V, EVENT_ID0);

    uint16_t one_rep_size = asc_get_vf_len() / sizeof(float); // 3510: 256B/4B = 64 lane/帧
    pltm_masked_scale_vf((__ubuf__ float*)x_local, (__ubuf__ float*)y_local,
                         active_count, TOTAL_LENGTH, one_rep_size);

    // UB -> GM（PIPE_MTE3）
    asc_sync_notify(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_sync_wait(PIPE_V, PIPE_MTE3, EVENT_ID0);
    asc_copy_ub2gm_align(y_gm, (__ubuf__ float*)y_local, 1, TOTAL_LENGTH * sizeof(float), 0, 0, 0);
    asc_sync_notify(PIPE_MTE3, PIPE_V, EVENT_ID0);
    asc_sync_wait(PIPE_MTE3, PIPE_V, EVENT_ID0);

    asc_sync();
}

// ---------------------------------------------------------------------------
// Host 侧：ACL 初始化 -> 数据搬入 -> kernel 启动 -> 结果搬回 -> 逐元素校验
// ---------------------------------------------------------------------------
std::vector<float> run_kernel(std::vector<float>& x, uint32_t x_count, int32_t device_id)
{
    size_t byte_size = x.size() * sizeof(float);

    uint8_t* y_host = nullptr;
    float* x_device = nullptr;
    float* y_device = nullptr;

    aclInit(nullptr);
    aclrtSetDevice(device_id);

    aclrtMallocHost((void**)(&y_host), byte_size);
    aclrtMalloc((void**)&x_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&y_device, byte_size, ACL_MEM_MALLOC_HUGE_FIRST);

    // 输出底色：y 全 1（mask 关闭的 lane 不会被写，保持 1）
    std::vector<float> y_ones(x.size(), 1.0f);
    aclrtMemcpy((uint8_t*)x_device, byte_size, x.data(), byte_size, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy((uint8_t*)y_device, byte_size, y_ones.data(), byte_size, ACL_MEMCPY_HOST_TO_DEVICE);

    pltm_demo_kernel<<<1, 0>>>(x_device, y_device, x_count);
    aclrtSynchronizeDevice();

    aclrtMemcpy(y_host, byte_size, (uint8_t*)y_device, byte_size, ACL_MEMCPY_DEVICE_TO_HOST);

    std::vector<float> y((float*)y_host, (float*)(y_host + byte_size));

    aclrtFree(x_device);
    aclrtFree(y_device);
    aclrtFreeHost(y_host);
    aclrtResetDevice(device_id);
    aclFinalize();
    return y;
}

// 结果校验：前 x 个必须为 2.0，其余必须为 1.0（float 可精确表示，逐元素比较）
uint32_t verify_result(std::vector<float>& output, uint32_t x_count)
{
    uint32_t pass_cnt = 0;
    uint32_t fail_cnt = 0;
    for (uint32_t i = 0; i < output.size(); ++i) {
        float expect = (i < x_count) ? 2.0f : 1.0f;
        if (output[i] == expect) {
            ++pass_cnt;
        } else {
            ++fail_cnt;
        }
    }
    std::cout << "Verification: pass " << pass_cnt << " / " << output.size()
              << " elements, fail " << fail_cnt << std::endl;
    if (fail_cnt == 0) {
        std::cout << "test pass!" << std::endl;
        return 0;
    }
    std::cout << "test fail!" << std::endl;
    return 1;
}

int32_t main(int32_t argc, char* argv[])
{
    int32_t device_id = 0;
    if (argc > 1) {
        device_id = std::atoi(argv[1]);
    }

    std::vector<float> x(TOTAL_LENGTH);
    std::vector<float> golden(TOTAL_LENGTH);
    uint32_t x_count = 0;

    size_t file_size = 0;
    if (!ReadFile("./input/input_x.bin", file_size, x.data(), TOTAL_LENGTH * sizeof(float))) {
        std::cout << "[Failed] Failed to read input/input_x.bin!" << std::endl;
        return 1;
    }
    if (!ReadFile("./input/x.bin", file_size, &x_count, sizeof(uint32_t))) {
        std::cout << "[Failed] Failed to read input/x.bin!" << std::endl;
        return 1;
    }
    if (!ReadFile("./output/golden.bin", file_size, golden.data(), TOTAL_LENGTH * sizeof(float))) {
        std::cout << "[Failed] Failed to read output/golden.bin!" << std::endl;
        return 1;
    }

    std::cout << "=== PLTM demo (pltm_b32 runtime mask) ===" << std::endl;
    std::cout << "TOTAL_LENGTH = " << TOTAL_LENGTH
              << " (b32: " << TOTAL_LENGTH / 64 << " frames x 64 lanes)" << std::endl;
    std::cout << "runtime x (active_count) = " << x_count << std::endl;

    std::vector<float> output = run_kernel(x, x_count, device_id);

    std::cout << "first 16 outputs: ";
    for (uint32_t i = 0; i < 16; ++i) {
        std::cout << output[i] << " ";
    }
    std::cout << std::endl;
    std::cout << "output[64..79]:    ";
    for (uint32_t i = 64; i < 80; ++i) {
        std::cout << output[i] << " ";
    }
    std::cout << std::endl;
    std::cout << "output[128..143]:  ";
    for (uint32_t i = 128; i < 144; ++i) {
        std::cout << output[i] << " ";
    }
    std::cout << std::endl;

    // 与 golden.bin（由 gen_data.py 按同一个 x 生成）做逐元素核对
    uint32_t mismatch = 0;
    for (uint32_t i = 0; i < TOTAL_LENGTH; ++i) {
        if (output[i] != golden[i]) {
            ++mismatch;
        }
    }
    if (mismatch != 0) {
        std::cout << "golden mismatch: " << mismatch << std::endl;
        return 1;
    }
    return verify_result(output, x_count);
}
